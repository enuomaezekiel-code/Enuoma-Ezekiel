rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kimmiyeon305@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // Admins list
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        // Allow updating completedJobs / ratings after job completion
        incoming().diff(existing()).affectedKeys().hasOnly(['completedJobs', 'rating', 'ratingCount'])
      );
      allow delete: if isAdmin();
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().clientId == request.auth.uid;
      allow update: if isSignedIn() && (
        existing().clientId == request.auth.uid ||
        existing().assignedWorkerId == request.auth.uid ||
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['applicationsCount', 'status', 'updatedAt'])
      );
      allow delete: if isSignedIn() && (existing().clientId == request.auth.uid || isAdmin());
    }

    // Applications collection
    match /applications/{applicationId} {
      allow read: if isSignedIn() && (
        resource.data.workerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().workerId == request.auth.uid;
      allow update: if isSignedIn() && (
        existing().clientId == request.auth.uid ||
        existing().workerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (existing().workerId == request.auth.uid || isAdmin());
    }

    // Job Submissions collection
    match /jobSubmissions/{submissionId} {
      allow read: if isSignedIn() && (
        resource.data.workerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().workerId == request.auth.uid;
      allow update: if isSignedIn() && (
        existing().clientId == request.auth.uid ||
        existing().workerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Job Events / Activity Audit Timeline
    match /jobEvents/{eventId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Payment Records
    match /paymentRecords/{recordId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.workerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().clientId == request.auth.uid ||
        incoming().workerId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        existing().clientId == request.auth.uid ||
        existing().workerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Trust & Safety Reports
    match /reports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.reporterId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Post-completion Reviews
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Platform Settings
    match /platformSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
